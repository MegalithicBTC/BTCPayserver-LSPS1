<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- ── Build settings ─────────────────────────────── -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <PreserveCompilationContext>false</PreserveCompilationContext>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <!-- ASP.NET Core (controllers, filters, etc.) -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- ── Plugin metadata ─────────────────────────────── -->
  <PropertyGroup>
    <Product>BTCPay Server – LSPS-1 plugin</Product>
    <Description>Quickly obtain inbound Lightning capacity via LSPS-1</Description>
    <Version>0.1.5</Version>
  </PropertyGroup>

  <!-- ── Unique identifiers (stop name collisions) ──── -->
  <PropertyGroup>
    <RestoreProjectName>BTCPayServer.Plugins.LSPS1</RestoreProjectName>
    <AssemblyName>BTCPayServer.Plugins.LSPS1</AssemblyName>
    <PackageId>BTCPayServer.Plugins.LSPS1</PackageId>
  </PropertyGroup>

  <!-- ── Project references (core + abstractions) ───── -->
  <ItemGroup>
    <!-- → points two levels up to your forked btcpayserver directory -->
    <ProjectReference Include="../../btcpayserver/BTCPayServer.Abstractions/BTCPayServer.Abstractions.csproj"
                      Private="false" StaticWebAssetsEnabled="false"
                      ExcludeAssets="runtime;native;build;buildTransitive;contentFiles" />

    <ProjectReference Include="../../btcpayserver/BTCPayServer/BTCPayServer.csproj"
                      Private="false" StaticWebAssetsEnabled="false"
                      ExcludeAssets="runtime;native;build;buildTransitive;contentFiles" />

    <EmbeddedResource Include="Resources\**" />
  </ItemGroup>

 <!-- ── NuGet packages used directly ───────────────── -->
<ItemGroup>
  <PackageReference Include="BTCPayServer.Lightning.All" Version="1.6.11" PrivateAssets="all" />
  <PackageReference Include="NBitcoin" Version="8.0.13" PrivateAssets="all" />
</ItemGroup>

</Project>