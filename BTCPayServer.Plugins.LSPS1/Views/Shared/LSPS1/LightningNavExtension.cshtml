@using BTCPayServer.Client
@using BTCPayServer.Views.Stores
@using BTCPayServer.Abstractions.Extensions
@addTagHelper *, BTCPayServer.Abstractions

@{ var store = Context.GetStoreDataOrNull(); }

@if (store != null)
{
    <li class="nav-item nav-item-sub" permission="@Policies.CanModifyStoreSettings">
        <a layout-menu-item="@Plugin.MenuId" asp-area="" asp-controller="LSPS1" asp-action="Index" asp-route-storeId="@store.Id">
            @await Html.PartialAsync("LSPS1/LightningIcon")
            <span text-translate="true">Get Lightning Channel</span>
        </a>
    </li>
}
